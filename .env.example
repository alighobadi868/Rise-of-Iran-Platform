NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/rise-of-iran.sqlite
TRUST_PROXY=0
# Optional AI provider. Keep secrets on the server; never expose them in public/app.js.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_ENABLED=false
# Set to a long, random secret if adding session-based features later.
APP_SECRET=

# Optional SMTP delivery for contact form notifications. Configure in Render Environment, never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=new.persia.rise@gmail.com
